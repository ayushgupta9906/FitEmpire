# ============================================================
# FitEmpire — Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================

# ---- Application ----
APP_ENV=production
APP_PORT=8080
APP_NAME=FitEmpire
APP_BASE_URL=https://api.fitempire.in
APP_FRONTEND_URL=https://app.fitempire.in
APP_ADMIN_URL=https://admin.fitempire.in

# ---- Database (PostgreSQL) ----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=fitempire
DB_USER=fitempire_user
DB_PASSWORD=your_strong_db_password_here
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_TTL_SECONDS=3600

# ---- JWT ----
JWT_SECRET=your_256_bit_jwt_secret_key_here_must_be_very_long_and_random
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_MS=604800000

# ---- OAuth2 — Google ----
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---- OAuth2 — Apple ----
APPLE_CLIENT_ID=com.fitempire.app
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key_pem

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# ---- Firebase (Push Notifications) ----
FIREBASE_PROJECT_ID=fitempire-prod
FIREBASE_SERVICE_ACCOUNT_JSON=/secrets/firebase-service-account.json

# ---- AWS S3 (File Storage) ----
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=fitempire-media-prod

# ---- Email (SMTP) ----
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
SMTP_FROM=noreply@fitempire.in
SMTP_FROM_NAME=FitEmpire

# ---- Twilio (SMS / OTP) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+919XXXXXXXXX

# ---- Google Maps ----
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ---- OpenAI (AI Features) ----
OPENAI_API_KEY=sk-xxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# ---- Rate Limiting ----
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=100

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/fitempire/app.log

# ---- Admin ----
ADMIN_DEFAULT_EMAIL=admin@fitempire.in
ADMIN_DEFAULT_PASSWORD=Admin@FitEmpire2024!

# ---- Nginx ----
NGINX_PORT=80
NGINX_SSL_PORT=443
SSL_CERT_PATH=/etc/ssl/certs/fitempire.crt
SSL_KEY_PATH=/etc/ssl/private/fitempire.key
